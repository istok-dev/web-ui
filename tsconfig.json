{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@istok-dev/tsconfig/react.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "lib",
    "rootDir": "src",
    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*", "global.d.ts"],
  "exclude": ["node_modules", "lib"]
}
