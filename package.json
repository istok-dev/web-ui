{
  "name": "@istok-dev/web-ui",
  "version": "0.0.40",
  "description": "UI-библиотека компонентов Istok",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "private": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "import": "./lib/utils/index.js",
      "default": "./lib/utils/index.js"
    },
    "./calendar": {
      "types": "./lib/components/calendar/index.d.ts",
      "import": "./lib/components/calendar/index.js",
      "default": "./lib/components/calendar/index.js"
    },
    "./date-input": {
      "types": "./lib/components/date-input/index.d.ts",
      "import": "./lib/components/date-input/index.js",
      "default": "./lib/components/date-input/index.js"
    },
    "./date-picker": {
      "types": "./lib/components/date-picker/index.d.ts",
      "import": "./lib/components/date-picker/index.js",
      "default": "./lib/components/date-picker/index.js"
    },
    "./styles.css": {
      "style": "./lib/styles/components/index.css",
      "default": "./lib/styles/components/index.css"
    },
    "./theme.css": {
      "style": "./lib/styles/theme.css",
      "default": "./lib/styles/theme.css"
    },
    "./avatar.css": {
      "style": "./lib/styles/components/avatar/ui/avatar.css",
      "default": "./lib/styles/components/avatar/ui/avatar.css"
    },
    "./badge.css": {
      "style": "./lib/styles/components/badge/ui/badge.css",
      "default": "./lib/styles/components/badge/ui/badge.css"
    },
    "./breadcrumbs.css": {
      "style": "./lib/styles/components/breadcrumbs/ui/breadcrumbs.css",
      "default": "./lib/styles/components/breadcrumbs/ui/breadcrumbs.css"
    },
    "./button.css": {
      "style": "./lib/styles/components/button/ui/button.css",
      "default": "./lib/styles/components/button/ui/button.css"
    },
    "./card.css": {
      "style": "./lib/styles/components/card/ui/card.css",
      "default": "./lib/styles/components/card/ui/card.css"
    },
    "./menu.css": {
      "style": "./lib/styles/components/menu/ui/menu.css",
      "default": "./lib/styles/components/menu/ui/menu.css"
    },
    "./menu-item.css": {
      "style": "./lib/styles/components/menu/ui/menu-item.css",
      "default": "./lib/styles/components/menu/ui/menu-item.css"
    },
    "./dropdown-item.css": {
      "style": "./lib/styles/components/menu/ui/menu-item.css",
      "default": "./lib/styles/components/menu/ui/menu-item.css"
    },
    "./icon-button.css": {
      "style": "./lib/styles/components/icon-button/ui/icon-button.css",
      "default": "./lib/styles/components/icon-button/ui/icon-button.css"
    },
    "./input.css": {
      "style": "./lib/styles/components/input/ui/input.css",
      "default": "./lib/styles/components/input/ui/input.css"
    },
    "./logo.css": {
      "style": "./lib/styles/components/logo/ui/logo.css",
      "default": "./lib/styles/components/logo/ui/logo.css"
    },
    "./number-input.css": {
      "style": "./lib/styles/components/number-input/ui/number-input.css",
      "default": "./lib/styles/components/number-input/ui/number-input.css"
    },
    "./progress.css": {
      "style": "./lib/styles/components/progress/ui/progress.css",
      "default": "./lib/styles/components/progress/ui/progress.css"
    },
    "./radio.css": {
      "style": "./lib/styles/components/radio/ui/radio.css",
      "default": "./lib/styles/components/radio/ui/radio.css"
    },
    "./select.css": {
      "style": "./lib/styles/components/select/ui/select.css",
      "default": "./lib/styles/components/select/ui/select.css"
    },
    "./tab-item.css": {
      "style": "./lib/styles/components/tabs/ui/tab-item.css",
      "default": "./lib/styles/components/tabs/ui/tab-item.css"
    },
    "./tabs.css": {
      "style": "./lib/styles/components/tabs/ui/tabs.css",
      "default": "./lib/styles/components/tabs/ui/tabs.css"
    },
    "./tag.css": {
      "style": "./lib/styles/components/tag/ui/tag.css",
      "default": "./lib/styles/components/tag/ui/tag.css"
    },
    "./textarea.css": {
      "style": "./lib/styles/components/textarea/ui/textarea.css",
      "default": "./lib/styles/components/textarea/ui/textarea.css"
    },
    "./checkbox.css": {
      "style": "./lib/styles/components/checkbox/ui/checkbox.css",
      "default": "./lib/styles/components/checkbox/ui/checkbox.css"
    },
    "./switch.css": {
      "style": "./lib/styles/components/switch/ui/switch.css",
      "default": "./lib/styles/components/switch/ui/switch.css"
    },
    "./tooltip.css": {
      "style": "./lib/styles/components/tooltip/ui/tooltip.css",
      "default": "./lib/styles/components/tooltip/ui/tooltip.css"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-day-picker": "*",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react-day-picker": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "clsx": "^2.1.1",
    "lucide-react": "1.45.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@istok-dev/eslint-react": "1.1.0",
    "@istok-dev/tsconfig": "2.0.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@11.0.9"
}
