{
  "name": "@istok-dev/web-ui",
  "version": "0.0.1",
  "description": "UI-библиотека компонентов Istok",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "import": "./lib/utils/index.js",
      "default": "./lib/utils/index.js"
    },
    "./styles.css": {
      "style": "./lib/styles/components/index.css",
      "default": "./lib/styles/components/index.css"
    },
    "./theme.css": {
      "style": "./lib/styles/theme.css",
      "default": "./lib/styles/theme.css"
    },
    "./avatar.css": {
      "style": "./lib/styles/components/avatar/ui/avatar.css",
      "default": "./lib/styles/components/avatar/ui/avatar.css"
    },
    "./badge.css": {
      "style": "./lib/styles/components/badge/ui/badge.css",
      "default": "./lib/styles/components/badge/ui/badge.css"
    },
    "./breadcrumbs.css": {
      "style": "./lib/styles/components/breadcrumbs/ui/breadcrumbs.css",
      "default": "./lib/styles/components/breadcrumbs/ui/breadcrumbs.css"
    },
    "./button.css": {
      "style": "./lib/styles/components/button/ui/button.css",
      "default": "./lib/styles/components/button/ui/button.css"
    },
    "./dropdown-item.css": {
      "style": "./lib/styles/components/dropdown/ui/dropdown-item.css",
      "default": "./lib/styles/components/dropdown/ui/dropdown-item.css"
    },
    "./icon-button.css": {
      "style": "./lib/styles/components/icon-button/ui/icon-button.css",
      "default": "./lib/styles/components/icon-button/ui/icon-button.css"
    },
    "./input.css": {
      "style": "./lib/styles/components/input/ui/input.css",
      "default": "./lib/styles/components/input/ui/input.css"
    },
    "./number-input.css": {
      "style": "./lib/styles/components/number-input/ui/number-input.css",
      "default": "./lib/styles/components/number-input/ui/number-input.css"
    },
    "./radio.css": {
      "style": "./lib/styles/components/radio/ui/radio.css",
      "default": "./lib/styles/components/radio/ui/radio.css"
    },
    "./select.css": {
      "style": "./lib/styles/components/select/ui/select.css",
      "default": "./lib/styles/components/select/ui/select.css"
    },
    "./tab-item.css": {
      "style": "./lib/styles/components/tabs/ui/tab-item.css",
      "default": "./lib/styles/components/tabs/ui/tab-item.css"
    },
    "./tabs.css": {
      "style": "./lib/styles/components/tabs/ui/tabs.css",
      "default": "./lib/styles/components/tabs/ui/tabs.css"
    },
    "./tag.css": {
      "style": "./lib/styles/components/tag/ui/tag.css",
      "default": "./lib/styles/components/tag/ui/tag.css"
    },
    "./checkbox.css": {
      "style": "./lib/styles/components/checkbox/ui/checkbox.css",
      "default": "./lib/styles/components/checkbox/ui/checkbox.css"
    },
    "./switch.css": {
      "style": "./lib/styles/components/switch/ui/switch.css",
      "default": "./lib/styles/components/switch/ui/switch.css"
    },
    "./tooltip.css": {
      "style": "./lib/styles/components/tooltip/ui/tooltip.css",
      "default": "./lib/styles/components/tooltip/ui/tooltip.css"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "npx tsc && tsc-alias -p tsconfig.json && node scripts/copy-css.cjs",
    "prepublishOnly": "pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-day-picker": "*"
  },
  "peerDependenciesMeta": {
    "react-day-picker": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.2.0",
    "clsx": "^2.1.1",
    "lodash-es": "4.17.23",
    "lucide-react": "0.575.0",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.2.13",
    "@storybook/test": "8.6.15",
    "@tailwindcss/vite": "4.2.1",
    "@types/lodash-es": "4.17.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "storybook": "10.2.13",
    "tailwindcss": "4.2.1",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@10.30.3"
}
